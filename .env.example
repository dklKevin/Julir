# ============================================
# JULIR APPLICATION ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local for development
# or .env.production for production builds
# ============================================

# Application Configuration
VITE_APP_NAME=Julir
VITE_APP_VERSION=2.0.0
VITE_APP_DESCRIPTION=Your voice companion for daily reflections

# API Endpoints
# These can be overridden if using a custom backend proxy
VITE_GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
VITE_GOOGLE_TTS_ENDPOINT=https://texttospeech.googleapis.com/v1/text:synthesize

# API keys must NEVER use a VITE_ prefix.
# Vite inlines every VITE_* value into the public JavaScript bundle.
# Users enter keys in Settings. A shared key belongs on a server proxy
# (unprefixed env vars only), not in this file or CI/hosting env.

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_TRACKING=false
VITE_DEMO_MODE=false

# Speech Recognition Configuration
VITE_SPEECH_LANGUAGE=en-US
VITE_SILENCE_TIMEOUT=4000
VITE_MAX_RECORDING_DURATION=60000
VITE_AUTO_LISTEN_DELAY=2500

# Optional: Analytics & Error Tracking
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Build Configuration
VITE_BASE_URL=/
